# Copy this file to ".env" and fill it in. ".env" is git-ignored: never commit it.
POLITO_USERNAME=s123456
POLITO_PASSWORD=your-password

# Optional
# POLITO_DOWNLOAD_DIR=C:\Users\you\Documents\Polito
# POLITO_SKIP_MIME=video/,audio/      # empty value = download everything
# POLITO_MAX_SIZE_MB=200              # 0 = no limit
# POLITO_ONLY_STUDY_PLAN=1            # 0 = include every course you can see
# POLITO_NEW_SUBFOLDER=New            # new files go in <course>\New\ ("" = course folder itself)
# POLITO_CREATE_MISSING_COURSE_FOLDERS=0   # 1 = create folders for courses you don't have yet
