# Your PoliTO login. This file stays on your PC and is never uploaded.
POLITO_USERNAME=s123456
POLITO_PASSWORD=your-password

# Folder where course files go. Leave as is for Documents\Polito, or set your own, e.g.
# POLITO_DOWNLOAD_DIR=C:\Users\you\Desktop\Polito

# 1 = create a folder for each course automatically. 0 = only use folders you already made
#     (folder names must match the PoliTO course names).
POLITO_CREATE_MISSING_COURSE_FOLDERS=1

# Optional
# POLITO_NEW_SUBFOLDER=New            # new files go in <course>\New\ ("" = course folder itself)
# POLITO_SKIP_MIME=video/,audio/      # empty value = download videos too
# POLITO_MAX_SIZE_MB=200              # 0 = no limit
# POLITO_ONLY_STUDY_PLAN=1            # 0 = include every course you can see
# ANTHROPIC_API_KEY=                  # Claude API key for "Summarize with Claude" (needs: pip install anthropic)
# POLITO_THEME=system                 # system / light / dark (also in Settings)
# POLITO_RIPPLE=1                     # 0 = no colour ripple when you click sync now / refresh
# POLITO_SIDEBAR=open                 # open / collapsed (the app remembers this for you)
# POLITO_DETAILED_DOWNLOAD=0          # 1 = pick files/folders before each download (switch on the Files page)
